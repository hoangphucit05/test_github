<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\Administration\AdminDashboardForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Administration\AdminDashboardForm.Designer.cs">
      <DependentUpon>AdminDashboardForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\Administration\AdminDashboardForm.resx">
      <DependentUpon>AdminDashboardForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\Administration\UserManagementView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\Administration\UserManagementView.Designer.cs">
      <DependentUpon>UserManagementView.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\Administration\UserManagementView.resx">
      <DependentUpon>UserManagementView.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\Authentication\Form1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Authentication\Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\Authentication\Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\Authentication\ForgotPasswordForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Authentication\ForgotPasswordForm.Designer.cs">
      <DependentUpon>ForgotPasswordForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\Authentication\ForgotPasswordForm.resx">
      <DependentUpon>ForgotPasswordForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
